# URL y clave pública del proyecto Supabase. Esta clave sí puede llegar al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta moderna, exclusiva del servidor: invitaciones y bootstrap inicial.
SUPABASE_SECRET_KEY=

# Alternativa sólo para proyectos con claves legacy; dejar vacía si se usa SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública exacta usada en enlaces de confirmación/OAuth.
APP_URL=http://localhost:3000

# Mantener false hasta completar Google Cloud y habilitar el provider en Supabase.
ENABLE_GOOGLE_AUTH=false

# Secreto aleatorio de 32+ caracteres para anonimizar IP/correo en rate limiting.
AUTH_RATE_LIMIT_SECRET=

# Pepper exclusivo del servidor para el historial de contraseñas (32+ caracteres).
PASSWORD_HISTORY_PEPPER=

# none | vercel | cloudflare | single-proxy. No se confía X-Forwarded-For por defecto.
TRUSTED_PROXY_PROVIDER=none

# Los datos ficticios sólo aparecen en desarrollo, o si este flag se habilita expresamente en servidor.
ENABLE_DEMO_DATA=false
